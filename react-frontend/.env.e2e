# E2E Test Environment Variables
# This file is loaded when running: npm run build:e2e

# Enable E2E test mode - this activates MSW mock server in the browser
VITE_E2E_TEST=true

# API Base URL for E2E tests (uses MSW mock handlers)
VITE_API_BASE_URL=/api/v1

# Mock API response delay (ms) - set to 0 or low value for E2E tests
VITE_API_DELAY=100

# Disable analytics in E2E test mode
VITE_ENABLE_ANALYTICS=false

# Enable debug logs for E2E tests
VITE_DEBUG=true
