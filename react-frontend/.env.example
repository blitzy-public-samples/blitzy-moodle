# ============================================================================
# Moodle React Frontend - Environment Variables Template
# ============================================================================
# This file documents all environment variables required for the React frontend.
# Copy this file to .env.development or .env.production and update values.
#
# IMPORTANT: All variables must be prefixed with VITE_ to be exposed to the
# client-side code. Vite only bundles variables with this prefix for security.
# ============================================================================

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------

# Base URL for the Moodle API v1 endpoints
# Development: http://localhost/api/v1 or http://localhost:8000/api/v1
# Production: https://yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost/api/v1

# API request timeout in milliseconds (default: 30 seconds)
VITE_API_TIMEOUT=30000

# API retry attempts for failed requests
VITE_API_RETRY_ATTEMPTS=3

# ----------------------------------------------------------------------------
# Application Metadata
# ----------------------------------------------------------------------------

# Application name displayed in the UI
VITE_APP_NAME=Moodle

# Application version (matches Moodle version with React suffix)
VITE_APP_VERSION=4.4.0-react

# Application environment (development, staging, production)
VITE_APP_ENV=development

# Public URL where the app is hosted (used for absolute URLs)
VITE_PUBLIC_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------

# JWT access token expiry time in seconds (default: 1 hour = 3600 seconds)
VITE_JWT_ACCESS_TOKEN_EXPIRY=3600

# JWT refresh token expiry time in seconds (default: 7 days = 604800 seconds)
VITE_JWT_REFRESH_TOKEN_EXPIRY=604800

# Token storage method: 'localStorage' or 'cookie' (cookie recommended for security)
VITE_TOKEN_STORAGE=localStorage

# Automatically refresh tokens before expiry (recommended: true)
VITE_AUTO_REFRESH_TOKEN=true

# Time before token expiry to trigger refresh in seconds (default: 5 minutes)
VITE_TOKEN_REFRESH_THRESHOLD=300

# ----------------------------------------------------------------------------
# Feature Flags (Gradual Rollout Support)
# ----------------------------------------------------------------------------

# Enable React dashboard (student/teacher/admin)
VITE_FEATURE_DASHBOARD=true

# Enable React course catalog and detail pages
VITE_FEATURE_COURSES=true

# Enable React assignment activities
VITE_FEATURE_ASSIGNMENTS=true

# Enable React quiz activities
VITE_FEATURE_QUIZZES=true

# Enable React forum activities
VITE_FEATURE_FORUMS=true

# Enable React gradebook
VITE_FEATURE_GRADEBOOK=true

# Enable React messaging system
VITE_FEATURE_MESSAGING=true

# Enable React administration pages
VITE_FEATURE_ADMIN=true

# Enable React user profile pages
VITE_FEATURE_PROFILE=true

# Enable offline mode support (Progressive Web App)
VITE_FEATURE_OFFLINE=false

# Enable real-time notifications via WebSocket
VITE_FEATURE_REALTIME=false

# ----------------------------------------------------------------------------
# File Upload Configuration
# ----------------------------------------------------------------------------

# Maximum file upload size in bytes (default: 100MB = 104857600 bytes)
VITE_MAX_FILE_SIZE=104857600

# Supported file types for upload (comma-separated extensions without dots)
VITE_SUPPORTED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,gif,svg,zip,mp4,mp3,txt,csv

# Maximum number of files per upload
VITE_MAX_FILES_PER_UPLOAD=10

# Enable drag-and-drop file upload
VITE_ENABLE_DRAG_DROP=true

# Enable file thumbnail generation
VITE_ENABLE_THUMBNAILS=true

# ----------------------------------------------------------------------------
# UI/UX Configuration
# ----------------------------------------------------------------------------

# Default theme mode: 'light', 'dark', or 'system'
VITE_DEFAULT_THEME=system

# Default language/locale (ISO 639-1 code)
VITE_DEFAULT_LOCALE=en

# Number of items per page in lists/tables
VITE_ITEMS_PER_PAGE=20

# Enable keyboard shortcuts
VITE_ENABLE_SHORTCUTS=true

# Enable animations and transitions
VITE_ENABLE_ANIMATIONS=true

# Sidebar default state: 'expanded' or 'collapsed'
VITE_SIDEBAR_DEFAULT=expanded

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------

# Enable Redux DevTools browser extension
VITE_ENABLE_DEVTOOLS=true

# Enable React Query DevTools
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true

# Enable Storybook component documentation
VITE_ENABLE_STORYBOOK=false

# Enable verbose logging in console (development only)
VITE_ENABLE_DEBUG_LOGS=true

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Enable error boundary detailed logs
VITE_ENABLE_ERROR_DETAILS=true

# ----------------------------------------------------------------------------
# Performance Configuration
# ----------------------------------------------------------------------------

# Enable code splitting and lazy loading
VITE_ENABLE_CODE_SPLITTING=true

# Enable service worker for caching (PWA)
VITE_ENABLE_SERVICE_WORKER=false

# Debounce delay for search inputs in milliseconds
VITE_SEARCH_DEBOUNCE=300

# Virtual scrolling threshold (number of items)
VITE_VIRTUAL_SCROLL_THRESHOLD=100

# Image lazy loading threshold in pixels
VITE_IMAGE_LAZY_THRESHOLD=50

# ----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# ----------------------------------------------------------------------------

# Google Analytics tracking ID (leave empty to disable)
VITE_GOOGLE_ANALYTICS_ID=

# Sentry DSN for error tracking (leave empty to disable)
VITE_SENTRY_DSN=

# Enable Sentry performance monitoring
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# External Services (Optional)
# ----------------------------------------------------------------------------

# WebSocket server URL for real-time features (leave empty to disable)
VITE_WEBSOCKET_URL=

# CDN URL for static assets (leave empty to serve from app)
VITE_CDN_URL=

# External media player URL (for video content)
VITE_MEDIA_PLAYER_URL=

# ----------------------------------------------------------------------------
# Accessibility
# ----------------------------------------------------------------------------

# Enable high contrast mode support
VITE_ENABLE_HIGH_CONTRAST=true

# Enable screen reader optimizations
VITE_ENABLE_SCREEN_READER=true

# Focus trap for modals and dialogs
VITE_ENABLE_FOCUS_TRAP=true

# ----------------------------------------------------------------------------
# Testing Configuration (Test Environment Only)
# ----------------------------------------------------------------------------

# Enable MSW (Mock Service Worker) for API mocking in tests
VITE_ENABLE_MSW=false

# Test user credentials (never use in production)
VITE_TEST_USERNAME=
VITE_TEST_PASSWORD=

# ----------------------------------------------------------------------------
# Build Configuration
# ----------------------------------------------------------------------------

# Enable source maps in production (not recommended for security)
VITE_GENERATE_SOURCEMAP=false

# Bundle size analyzer (development only)
VITE_ANALYZE_BUNDLE=false

# Minify output (production only)
VITE_MINIFY=true

# ----------------------------------------------------------------------------
# CORS Configuration (Informational - handled by API server)
# ----------------------------------------------------------------------------

# These are handled by the API backend, documented here for reference:
# - CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins
# - CORS_ALLOWED_METHODS: GET,POST,PUT,DELETE,OPTIONS
# - CORS_ALLOWED_HEADERS: Content-Type,Authorization,X-Requested-With
# - CORS_MAX_AGE: 86400 (24 hours in seconds)

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Copy this file to .env.development for local development
# 2. Copy this file to .env.production for production builds
# 3. Update values according to your environment
# 4. Never commit .env.development or .env.production to version control
# 5. Keep sensitive values (API keys, credentials) out of client-side code
# ============================================================================
